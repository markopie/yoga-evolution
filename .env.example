# Copy this file to .env.local for local development.
# Do not commit .env.local.
#
# Normal development and testing should use the hosted Supabase project.
# Use the same values configured in GitHub Actions as:
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_PUBLISHABLE_KEY

VITE_SUPABASE_TARGET=cloud
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-hosted-key

# The private local Supabase instance is only for personal/local data.
# To use it deliberately, replace the values above with the output of:
#   npx.cmd supabase status

# Optional visible label for non-live builds (for example, PR 51).
# Empty, production, prod, and live values keep the test banner hidden.
VITE_APP_ENV=
